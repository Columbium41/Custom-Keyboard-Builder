# Test environment, loaded by vitest.config.ts and playwright.config.ts (never by the app itself).
# Values here are non-secret defaults used by CI. Override locally in .env.test.local (gitignored).
# The database name must end in "_test", tests refuse to run otherwise.

NEXT_PUBLIC_BASE_URL="http://localhost:3100"
NEXTAUTH_URL="http://localhost:3100"

NEXTAUTH_SECRET="test-nextauth-secret"
EMAIL_SECRET="test-email-secret"
PASSWORD_RESET_SECRET="test-password-reset-secret"

EMAIL_USER="test@example.com"
EMAIL_PASS="unused"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mechforum_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mechforum_test?schema=public"

GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_CLIENT_SECRET="test-google-client-secret"

# recaptcha verification is mocked (axios) in tests
NEXT_PUBLIC_RECAPTCHA_SITEKEY="test-recaptcha-sitekey"
RECAPTCHA_SECRET_KEY="test-recaptcha-secret"

AWS_BUCKET_NAME="test-bucket"
AWS_BUCKET_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test-access-key"
AWS_SECRET_ACCESS_KEY="test-secret-key"
AWS_BUCKET_URL="test-bucket.s3.us-east-1.amazonaws.com"

YOUTUBE_API_KEY="test-youtube-key"
